---
import '../styles/global.css';
import { studio } from '../config';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  /** Extra Google Fonts families for this page, e.g. the typefaces shown in a case study. */
  fonts?: string;
}
const {
  title,
  description = 'Maison Null is a design house in Singapore. It designs websites and apps, then builds them properly.',
  current = '',
  fonts,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} | ${studio.name}` : studio.name;
const links = [
  { href: '/work/', label: 'Samples', key: 'work' },
  { href: '/commissions/', label: 'Services', key: 'commissions' },
  { href: '/studio/', label: 'Studio', key: 'studio' },
];
const cta = { href: '/contact/', label: 'Start a project', key: 'contact' };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#E8E8E4" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400&display=swap"
    rel="stylesheet"
  />
  <script is:inline>
    // Count a step (wrote in the frame, sent the brief, submitted, booked a call). Does nothing if counting is off.
    window.mnTrack = function (path, title) {
      try { if (window.goatcounter && window.goatcounter.count) window.goatcounter.count({ path: path, title: title || path, event: true }); } catch (e) {}
    };
  </script>
  {studio.goatcounter && <script is:inline data-goatcounter={`https://${studio.goatcounter}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>}
  {fonts && <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />}
</head>
<body class={current === 'home' ? 'is-home' : undefined}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap">
      <a class="wordmark" href={`${base}/`}>Maison<code>null</code></a>
      <nav class="nav" aria-label="Main">
        {links.map((l) => (
          <a href={`${base}${l.href}`} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        ))}
        <a class="nav-cta" href={`${base}${cta.href}`} aria-current={current === cta.key ? 'page' : undefined}>{cta.label}</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-foot">
    <div class="wrap foot-row">
      <p>A design house in Singapore. Interfaces first, built properly underneath.</p>
      <nav class="nav" aria-label="Footer">
        {[...links, cta].map((l) => <a href={`${base}${l.href}`}>{l.label}</a>)}
      </nav>
    </div>
    <p class="foot-mark" aria-hidden="true">Maison<code>null</code></p>
  </footer>
  <script>
    const head = document.querySelector('.site-head');
    const onScroll = () => head?.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
  </script>
</body>
</html>
