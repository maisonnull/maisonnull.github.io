---
import '../styles/global.css';
import { studio } from '../config';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const {
  title,
  description = 'Maison Null designs and builds websites, apps and products of its own.',
  current = '',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} | ${studio.name}` : studio.name;
const links = [
  { href: '/work/', label: 'Work', key: 'work' },
  { href: '/commissions/', label: 'Commissions', key: 'commissions' },
  { href: '/studio/', label: 'Studio', key: 'studio' },
  { href: '/contact/', label: 'Contact', key: 'contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#3B1D22" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap">
      <a class="wordmark" href={`${base}/`}>Maison<code>null</code></a>
      <nav class="nav" aria-label="Main">
        {links.map((l) => (
          <a href={`${base}${l.href}`} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-foot">
    <div class="wrap">
      <div>
        <a class="wordmark" href={`${base}/`}>Maison<code>null</code></a>
        <p>A studio for well-made software. Singapore, {new Date().getFullYear()}.</p>
      </div>
      <nav class="nav" aria-label="Footer">
        {links.map((l) => <a href={`${base}${l.href}`}>{l.label}</a>)}
      </nav>
    </div>
  </footer>
</body>
</html>
