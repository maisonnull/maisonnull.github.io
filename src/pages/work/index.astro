---
import Base from '../../layouts/Base.astro';
import Device from '../../components/Device.astro';
import { getCollection } from 'astro:content';
import { samples } from '../../data/samples';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Samples" current="work" description="Interface design samples by Maison Null: real screens, palettes and typefaces.">
  <section class="banner">
    <div class="wrap">
      <h1>Samples</h1>
      <p class="lede">Interfaces designed and built in the house, shown as examples of what can be made for you. Each one comes with its design system and the decision that shaped it.</p>
    </div>
  </section>
  <section class="wrap list">
    {work.map((p) => {
      const s = samples[p.id];
      return (
        <a class="tile" href={`${base}/work/${p.id}/`} style={`--tint:${s.tint}`}>
          <span class="t-room">
            <Device kind="browser" src={`${s.hero.src}-top`} w={2000} h={1250} alt="" />
          </span>
          <span class="t-body">
            <span class="t-title">{p.data.title}</span>
            <span class="t-sum">{p.data.summary}</span>
            <span class="t-meta">{p.data.kind}, for {p.data.sector.toLowerCase()}</span>
          </span>
        </a>
      );
    })}
  </section>
</Base>
<style>
  .list{display:grid;gap:clamp(3rem,7vw,6rem);padding-bottom:clamp(4rem,9vw,7rem)}
  .tile{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:1.5rem clamp(2rem,5vw,4.5rem);align-items:end;text-decoration:none}
  .t-room{display:block;background:var(--tint);border-radius:24px;padding:clamp(1rem,4vw,3.5rem)}
  .t-room :global(.device){transition:transform .5s cubic-bezier(.2,.7,.2,1)}
  .tile:hover .t-room :global(.device){transform:translateY(-6px)}
  .t-body{display:flex;flex-direction:column;gap:.8rem}
  .t-title{font-family:var(--serif);font-size:clamp(3rem,7vw,6rem);line-height:.9;letter-spacing:-.02em}
  .tile:hover .t-title{text-decoration:underline;text-decoration-thickness:2px;text-decoration-color:var(--cobalt);text-underline-offset:.1em}
  .t-sum{max-width:40ch}
  .t-meta{font-size:.9rem;color:var(--ink-soft)}
  @media (max-width:860px){.tile{grid-template-columns:1fr}}
</style>
