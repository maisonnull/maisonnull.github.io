---
import Base from '../../layouts/Base.astro';
import Phone from '../../components/Phone.astro';
import { getCollection, render } from 'astro:content';
import { plinth } from '../../data/plinths';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = entry.data;
---
<Base title={d.title} current="work" description={d.summary}>
  <section class="cs-hero">
    <div class="wrap cs-grid">
      <div>
        <a class="back" href={`${base}/work/`}>All work</a>
        <p class="cs-res" data-res={d.result}>{d.result}</p>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <dl class="placard-data">
          <dt>Year</dt><dd>{d.year}</dd>
          <dt>Medium</dt><dd>{d.medium}</dd>
          <dt>Provenance</dt><dd>{d.provenance}</dd>
        </dl>
        {d.link && <div class="btns"><a class="btn primary" href={d.link}>{d.linkLabel ?? 'Visit'}</a></div>}
      </div>
      <div class="cs-plinth" style={`--plinth:${plinth[entry.id] ?? '#E7E2D8'}`}>
        <Phone id={entry.id} scale={0.9} />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <article class="prose"><Content /></article>
      {d.link && <div class="btns"><a class="btn ink" href={d.link}>{d.linkLabel ?? 'Visit'}</a></div>}
    </div>
  </section>
  <a class="next" href={`${base}/work/${next.id}/`}>
    <span class="wrap next-in">
      <span class="n-label">Next piece</span>
      <span class="n-title">{next.data.title}</span>
    </span>
  </a>
</Base>
<style>
  .cs-hero{background:#140A0C;color:var(--ivory);padding:clamp(3rem,8vw,5.5rem) 0 clamp(3rem,7vw,5rem)}
  .cs-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:2.5rem clamp(2.5rem,6vw,5rem);align-items:center}
  .cs-hero h1{font-size:clamp(3rem,7.4vw,6.6rem);line-height:.92;letter-spacing:-.03em;font-weight:400}
  .cs-hero .back{display:block;width:max-content;margin-bottom:1.4rem}
  .cs-hero .placard-data{margin-top:1.8rem;font-size:.92rem}
  .cs-hero .placard-data dt{color:var(--ivory-soft)}
  .cs-res{display:inline-block;margin:0 0 1.2rem;padding:.3rem .8rem;border-radius:999px;border:1px solid rgba(239,233,220,.5);font-size:.85rem;font-weight:600}
  .cs-res[data-res="Track winner"],.cs-res[data-res="2nd place"]{background:var(--brass);border-color:var(--brass);color:#1C0E11}
  .cs-hero .btn.primary{background:var(--ivory);color:#1C0E11;border-color:var(--ivory)}
  .cs-plinth{position:relative;display:flex;justify-content:center;align-items:center;min-height:560px;border-radius:28px;background:var(--plinth);overflow:hidden}
  .cs-plinth::before{content:'';position:absolute;inset:auto 22% 6% 22%;height:22px;border-radius:50%;background:rgba(0,0,0,.3);filter:blur(16px)}
  .next{display:block;background:var(--wall);color:var(--ivory);text-decoration:none;padding:clamp(3rem,8vw,5rem) 0;transition:background .3s}
  .next:hover{background:#4A242B}
  .next-in{display:flex;flex-direction:column;gap:.4rem}
  .n-label{font-family:var(--serif);font-style:italic;color:var(--brass);font-size:1.15rem}
  .n-title{font-family:var(--serif);font-size:clamp(2.6rem,7vw,6rem);line-height:.95;letter-spacing:-.03em}
  .next:hover .n-title{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:.12em}
  @media (max-width:860px){
    .cs-grid{grid-template-columns:1fr}
    .cs-plinth{min-height:0;height:340px;align-items:flex-start;padding-top:28px}
    .cs-plinth :global(.phone-holder){--s:.72 !important}
  }
</style>
