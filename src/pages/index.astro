---
import Base from '../layouts/Base.astro';
import BriefFrame from '../components/BriefFrame.astro';
import Device from '../components/Device.astro';
import { getCollection } from 'astro:content';
import { samples } from '../data/samples';
import { studio } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const MFW = samples['maison-francis-kurkdjian'].hero.w, MFH = samples['maison-francis-kurkdjian'].hero.h;
const SLW = samples['song-lang-garden'].phone.w, SLH = samples['song-lang-garden'].phone.h;

const services = [
  {
    name: 'Interface design',
    text: 'Dashboards, apps and tools that make a complicated job feel simple.',
    items: ['Screens for desktop and phone', 'A design system: colour, type and components', 'A prototype you can click through'],
  },
  {
    name: 'Websites',
    text: 'Sites for businesses that want to look as good as their work.',
    items: ['Landing pages and full sites', 'Words edited for clarity', 'Live on your own domain'],
  },
  {
    name: 'Design and build',
    text: 'The design, built and launched, with AI only where it genuinely helps.',
    items: ['Web apps with sign-ins and payments', 'AI features that are checked, not trusted blindly', 'Hosting and care after launch'],
  },
];

const backOfHouse = [
  { name: 'Built by the same hands', text: 'Nothing gets lost between the mockup and the live site, because the person who designed it builds it.' },
  { name: 'Fast and accessible', text: 'Quick on an old phone and a slow connection, usable by keyboard and screen reader, readable contrast throughout.' },
  { name: 'AI with a supervisor', text: 'Models suggest and draft. Plain, tested code checks anything involving money, dates or amounts.' },
  { name: 'Yours to keep', text: 'Domain, hosting and code are set up in your name from the first day.' },
];

const steps = [
  { name: 'Brief', text: 'Write a sentence about what you need. You get a reply within two working days.' },
  { name: 'Design', text: 'Screens first, so you can see and change the product before it is built.' },
  { name: 'Build', text: 'A private preview link from the first week. Nothing is a surprise.' },
  { name: 'Launch', text: 'Live on your domain, with a short guide for the edits you will make yourself.' },
];
---
<Base current="home">
  <!-- Hero: the work is the first thing you see -->
  <section class="hero" data-hero>
    <div class="wrap hero-top">
      <h1>Interfaces worth using,<br class="br" /> built properly underneath.</h1>
      <div class="hero-side">
        <p class="lede">Maison Null is a design house in Singapore. It designs websites and apps people enjoy using, then builds them so they keep working.</p>
        <div class="btns">
          <a class="btn solid" href={`${base}/contact/`}>Start a project</a>
          {studio.callLink && <a class="btn" href={studio.callLink} target="_blank" rel="noopener" data-call>Book a 15-minute call</a>}
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="track" data-track>
      <div class="stage">
        <Device kind="browser" class="st-main" src="mf-home" w={MFW} h={MFH} mode="scroll" eager
          alt="Maison Francis Kurkdjian concept: the red Baccarat Rouge 540 Extrait bottle beside its name in a large serif." />
        <Device kind="phone" class="st-phone" src="sl-m-home" w={SLW} h={SLH} mode="scroll" eager top="#24452F"
          alt="Song Lang Garden concept on a phone: a full-bleed photo of the nursery under the headline A Katong nursery for every kind of space." />
      </div>
      </div>
      <div class="st-caps">
        <p><a href={`${base}/work/maison-francis-kurkdjian/`}>Maison Francis Kurkdjian</a>, a perfume boutique concept</p>
        <p><a href={`${base}/work/song-lang-garden/`}>Song Lang Garden</a>, a plant nursery concept</p>
        <p class="st-note">Unsolicited redesigns of real brands, made by the studio. Not affiliated with or endorsed by them.</p>
      </div>
    </div>
  </section>

  <!-- Samples -->
  <section class="samples" id="samples">
    <div class="wrap s-head">
      <h2>Selected samples</h2>
      <p>Three unsolicited redesigns of real Singapore favourites, designed and built in the house to show what the studio can do. None is client work. Hover over a screen, or tab to it, to scroll through the whole page.</p>
    </div>

    {work.map((p) => {
      const s = samples[p.id];
      return (
        <article class="sample" style={`--tint:${s.tint}`}>
          <div class="wrap sample-head">
            <h3 class="sample-title"><a href={`${base}/work/${p.id}/`}>{p.data.title}</a></h3>
            <div class="sample-text">
              <p class="sample-sum">{p.data.summary}</p>
              <dl class="placard-data">
                <dt>Type</dt><dd>{p.data.kind}</dd>
                <dt>Designed for</dt><dd>{p.data.sector}</dd>
              </dl>
              <a class="textlink" href={`${base}/work/${p.id}/`}>Read the case study</a>
              {p.data.live && <a class="textlink" href={p.data.live} target="_blank" rel="noopener">Open the live concept</a>}
            </div>
          </div>
          <div class="wrap">
            <div class="room room-split">
              <Device kind="browser" src={s.hero.src} w={s.hero.w} h={s.hero.h} mode="hover" alt={`${p.data.title} concept: ${s.hero.caption}`} />
              <Device kind="phone" src={s.phone.src} w={s.phone.w} h={s.phone.h} mode="hover" top={s.top} alt={`${p.data.title} concept on a phone: ${s.phone.caption}`} />
            </div>
            <div class="paint" aria-label={`${p.data.title} colour palette`}>
              {s.palette.map((c) => (
                <div class="chip">
                  <span class="chip-c" style={`background:${c.hex}`}></span>
                  <span class="chip-n">{c.name}</span>
                  <span class="chip-h">{c.hex}</span>
                </div>
              ))}
              <p class="faces">Set in {s.faces.map((f) => f.name).join(', ').replace(/, ([^,]*)$/, ' and $1')}.</p>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <!-- What the studio designs -->
  <section class="services">
    <div class="wrap">
      <div class="sv-head">
        <h2>What the studio designs</h2>
        <a class="textlink" href={`${base}/commissions/`}>Services and prices</a>
      </div>
      <div class="sv-grid">
        {services.map((s) => (
          <div class="sv">
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Back of house -->
  <section class="boh">
    <div class="wrap boh-grid">
      <div>
        <h2>Back of house</h2>
        <p class="boh-lede">Design leads. The engineering behind it is quiet, careful and done properly, so the interface you approved is the one that ships.</p>
      </div>
      <dl class="boh-list">
        {backOfHouse.map((b) => (<div><dt>{b.name}</dt><dd>{b.text}</dd></div>))}
      </dl>
    </div>
  </section>

  <!-- Process -->
  <section class="process">
    <div class="wrap">
      <h2>From a sentence to launch</h2>
      <ol class="steps">
        {steps.map((s) => (<li><h3>{s.name}</h3><p>{s.text}</p></li>))}
      </ol>
    </div>
  </section>

  <!-- Closing: write the brief -->
  <section class="closing">
    <div class="wrap closing-grid">
      <div>
        <h2>Start with a sentence.</h2>
        <p>Write what you would like made in the frame. That is enough to begin, and you can add the details on the next page.</p>
        <div class="btns">
          <a class="btn solid" href={`${base}/contact/`}>Start a project</a>
          {studio.callLink && <a class="textlink" href={studio.callLink} target="_blank" rel="noopener" data-call>Or book a 15-minute call</a>}
        </div>
      </div>
      <BriefFrame />
    </div>
  </section>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  requestAnimationFrame(() => document.querySelector('[data-hero]')?.classList.add('in'));
  document.querySelectorAll('[data-call]').forEach((a) => a.addEventListener('click', () => (window as any).mnTrack?.('call-booking-opened', 'Opened the call booking page')));

  // The hero screens scroll with the page: the one moving moment on the site.
  // On wide screens the stage is pinned while the visitor scrolls through a taller track,
  // each screen travels at most a few of its own heights, and the motion eases towards
  // its target so the pages can actually be read as they pass.
  const track = document.querySelector<HTMLElement>('[data-track]');
  const live = [...document.querySelectorAll<HTMLElement>('.hero [data-mode="scroll"] .screen')];
  if (track && live.length && !reduce) {
    const state = live.map(() => ({ cur: 0, target: 0 }));
    let running = false;
    const progress = () => {
      const r = track.getBoundingClientRect();
      const pinned = getComputedStyle(track).getPropertyValue('--pinned').trim() === '1';
      if (pinned) {
        const run = r.height - innerHeight;           // scroll distance while the stage is pinned
        return Math.min(1, Math.max(0, -r.top / Math.max(1, run)));
      }
      return Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / (r.height + innerHeight * 0.6)));
    };
    const frame = () => {
      const t = progress();
      let moving = false;
      live.forEach((el, i) => {
        const img = el.querySelector('img');
        if (!img) return;
        const view = el.clientHeight;
        const travel = Math.min(Math.max(0, img.clientHeight - view), view * 3.2);
        const st = state[i];
        st.target = -t * travel;
        st.cur += (st.target - st.cur) * 0.09;
        if (Math.abs(st.target - st.cur) > 0.3) moving = true; else st.cur = st.target;
        el.style.setProperty('--y', st.cur.toFixed(1) + 'px');
      });
      running = moving;
      if (moving) requestAnimationFrame(frame);
    };
    const kick = () => { if (!running) { running = true; requestAnimationFrame(frame); } };
    addEventListener('scroll', kick, { passive: true }); addEventListener('resize', kick); kick();
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero{padding:clamp(2rem,5vw,4rem) 0 clamp(3rem,7vw,6rem);overflow:clip}
  /* Wide screens: the stage pins while the page scrolls through the track. */
  .track{--pinned:0}
  @media (min-width:900px) and (min-height:600px) and (prefers-reduced-motion:no-preference){
    .track{--pinned:1;height:270vh}
    .track .stage{position:sticky;top:max(5.5rem,calc(50vh - 22rem))}
  }
  .hero h1{font-size:clamp(3rem,6.9vw,7rem);line-height:.94}
  @media (max-width:760px){.hero h1 .br{display:none}}
  .hero-side{display:flex;justify-content:space-between;align-items:flex-end;gap:1.2rem 3rem;flex-wrap:wrap;margin-top:clamp(1.4rem,3vw,2.2rem)}
  .hero-side .lede{margin:0}
  .hero-side .btns{margin:0}
  .stage{position:relative;margin-top:clamp(2.5rem,5vw,4rem);padding-right:clamp(3rem,13vw,13rem)}
  .stage :global(.st-phone){position:absolute;right:0;bottom:clamp(-3rem,-4vw,-1.5rem);width:clamp(9rem,21%,17.5rem)}
  .st-caps{display:flex;justify-content:space-between;gap:1rem 2rem;flex-wrap:wrap;margin-top:clamp(4rem,7vw,5.5rem);font-size:.92rem;color:var(--ink-soft)}
  .st-caps p{margin:0}
  .st-caps a{color:var(--ink)}
  .st-caps .st-note{flex-basis:100%;font-size:.85rem}
  .sample-text .textlink + .textlink{margin-left:1.5rem}
  /* one load-in moment */
  .stage{opacity:0;transform:translateY(40px);transition:opacity 1s cubic-bezier(.2,.7,.2,1) .15s,transform 1.2s cubic-bezier(.2,.7,.2,1) .15s}
  .hero.in .stage{opacity:1;transform:none}

  /* ---------- samples ---------- */
  .samples{padding:clamp(3.5rem,8vw,6.5rem) 0 clamp(2rem,4vw,3rem);border-top:1px solid var(--line)}
  .s-head{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:1rem clamp(2rem,5vw,5rem);align-items:end;margin-bottom:clamp(2.5rem,5vw,4rem)}
  .s-head p{margin:0;color:var(--ink-soft);max-width:40ch}
  .sample{margin-bottom:clamp(4.5rem,9vw,8rem)}
  .sample-head{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:1.2rem clamp(2rem,5vw,5rem);align-items:end;margin-bottom:1.8rem}
  .sample-title{font-size:clamp(3.4rem,10vw,9.5rem);line-height:.86;letter-spacing:-.025em}
  .sample-title a{text-decoration:none}
  .sample-title a:hover{text-decoration:underline;text-decoration-thickness:2px;text-decoration-color:var(--cobalt)}
  .sample-sum{margin:0 0 1rem;max-width:42ch}
  .sample-text .placard-data{margin-bottom:1.2rem;font-size:.9rem}
  .room{background:var(--tint);border-radius:24px;padding:clamp(1.25rem,4vw,3.5rem)}
  .room-split{display:grid;grid-template-columns:minmax(0,1fr) clamp(8.5rem,21%,16rem);gap:clamp(1rem,3vw,2.5rem);align-items:center}
  .room-phones{display:grid;grid-template-columns:repeat(3,minmax(0,16.5rem));justify-content:center;gap:clamp(1rem,4vw,3.5rem)}
  .room-phones :global(.device:nth-child(2)){transform:translateY(-1.5rem)}
  .paint{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:1px;margin-top:1.25rem;font-size:.82rem}
  .chip{display:flex;flex-direction:column;gap:.15rem;min-width:0}
  .chip-c{display:block;height:3.4rem;border-radius:3px;margin-bottom:.45rem;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}
  .chip-n{font-weight:500}
  .chip-h{color:var(--ink-soft);font-variant-numeric:tabular-nums}
  .faces{grid-column:1 / -1;margin:.9rem 0 0;color:var(--ink-soft)}

  /* ---------- services ---------- */
  .services{padding:clamp(4rem,9vw,7rem) 0;background:var(--paper);border-block:1px solid var(--line)}
  .sv-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem 2rem;flex-wrap:wrap;margin-bottom:clamp(2.2rem,4vw,3.2rem)}
  .sv-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem clamp(2rem,4vw,3.5rem)}
  .sv{border-top:1px solid var(--ink);padding-top:1.2rem}
  .sv h3{font-size:clamp(2rem,3vw,2.6rem);margin-bottom:.7rem}
  .sv p{margin:0 0 1.1rem;max-width:34ch}
  .sv ul{margin:0;padding:0;list-style:none;color:var(--ink-soft);font-size:.95rem}
  .sv li{padding:.55rem 0;border-top:1px solid var(--line)}

  /* ---------- back of house ---------- */
  .boh{padding:clamp(4rem,9vw,7rem) 0}
  .boh-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:2.5rem clamp(2.5rem,6vw,6rem)}
  .boh-lede{margin:1.2rem 0 0;max-width:36ch;color:var(--ink-soft);font-size:1.15rem}
  .boh-list{margin:0;display:grid;grid-template-columns:1fr 1fr;gap:2rem 2.5rem}
  .boh-list div{border-top:1px solid var(--line);padding-top:1rem}
  .boh-list dt{font-weight:600;margin-bottom:.35rem}
  .boh-list dd{margin:0;color:var(--ink-soft);font-size:.98rem}

  /* ---------- process ---------- */
  .process{padding:0 0 clamp(4rem,9vw,7rem)}
  .process h2{margin-bottom:clamp(2rem,4vw,3rem)}
  .steps{list-style:none;counter-reset:s;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2rem}
  .steps li{counter-increment:s;border-top:1px solid var(--ink);padding-top:1rem}
  .steps li::before{content:counter(s);display:block;font-family:var(--serif);font-size:3rem;line-height:1;color:var(--cobalt);margin-bottom:.8rem}
  .steps h3{font-size:1.7rem;margin-bottom:.4rem}
  .steps p{margin:0;color:var(--ink-soft);font-size:.98rem}

  /* ---------- closing ---------- */
  .closing{padding:clamp(4rem,9vw,7rem) 0;background:var(--paper);border-top:1px solid var(--line)}
  .closing-grid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3rem clamp(2.5rem,6vw,6rem);align-items:center}
  .closing h2{font-size:clamp(3rem,7vw,6rem);line-height:.95;max-width:9ch}
  .closing p{margin:1.4rem 0 0;max-width:38ch;color:var(--ink-soft);font-size:1.1rem}

  /* ---------- responsive ---------- */
  @media (max-width:960px){
    .s-head,.sample-head,.boh-grid,.closing-grid{grid-template-columns:1fr}
    .sv-grid{grid-template-columns:1fr}
    .steps{grid-template-columns:1fr 1fr}
    .paint{grid-template-columns:repeat(3,minmax(0,1fr));row-gap:1rem}
  }
  @media (max-width:640px){
    .stage{padding-right:0;padding-bottom:5.5rem}
    .stage :global(.st-phone){width:36%;bottom:0}
    .st-caps{margin-top:1.5rem}
    .room-split{grid-template-columns:1fr}
    .room-split :global(.device.phone){width:62%;justify-self:center}
    .room-phones{display:flex;gap:1rem;overflow-x:auto;scroll-snap-type:x mandatory;padding:1.25rem;scrollbar-width:none}
    .room-phones::-webkit-scrollbar{display:none}
    .room-phones :global(.device){flex:0 0 64%;scroll-snap-align:center}
    .room-phones :global(.device:nth-child(2)){transform:none}
    .boh-list,.steps{grid-template-columns:1fr}
  }
  @media (prefers-reduced-motion:reduce){
    .stage{opacity:1;transform:none;transition:none}
  }
</style>
