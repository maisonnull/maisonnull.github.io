---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Not found">
  <section class="banner nf">
    <div class="wrap">
      <h1>This page returned <code>null</code>.</h1>
      <p class="lede">There is nothing at this address. It may have moved, or the link may be mistyped.</p>
      <div class="btns"><a class="btn solid" href={`${base}/`}>Go to the home page</a><a class="textlink" href={`${base}/work/`}>See the samples</a></div>
    </div>
  </section>
</Base>
<style>
  .nf{min-height:60vh}
  .nf code{font-family:var(--mono);font-size:.62em;color:var(--cobalt);letter-spacing:-.03em}
</style>
