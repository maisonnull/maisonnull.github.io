---
import Base from '../layouts/Base.astro';
import { practices, waysToWork, collective, ordering, founding, included, faq } from '../commissions';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
  { name: 'Enquire', text: 'Tell us what you need and when. We reply within two working days.' },
  { name: 'Scope', text: 'We agree what is being made, the price and the dates, in writing, before any work starts.' },
  { name: 'Design', text: 'You see the design first, so it can change before anything is built or printed.' },
  { name: 'Build', text: 'You get a private preview link, or proofs, to check progress as it takes shape.' },
  { name: 'Launch', text: 'It goes live on your domain, or to print, in your name. You own everything, including the source files.' },
];
---
<Base title="Services" current="commissions" description="Brand, digital products and restaurant ordering by Maison Null, with starting prices.">
  <section class="banner">
    <div class="wrap">
      <h1>Services and prices</h1>
      <p class="lede">Three practices, one studio. Every project is designed before anything is built or printed, and quoted in writing, in Singapore dollars, before work begins.</p>
      <ul class="index">
        {practices.map((p) => (
          <li><a href={p.link ? `${base}${p.link}` : `#${p.id}`}><span class="ix-n">{p.name}</span><span class="ix-p">{p.price}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  {founding.enabled && (
    <section class="founding" id="founding">
      <div class="wrap founding-inner">
        <p class="f-tag">Founding commissions</p>
        <div>
          <h2>{founding.discount} for the first {founding.slots} clients.</h2>
          <p>The house is new, so the first {founding.slots} commissions are discounted, {founding.terms}. Same scope, same care, lower price.</p>
        </div>
        <a class="btn solid" href={`${base}/contact/`}>Claim a founding spot</a>
      </div>
    </section>
  )}

  {practices.filter((p) => p.tiers.length).map((p) => (
    <section class="section practice" id={p.id}>
      <div class="wrap pr-grid">
        <div class="pr-head">
          <h2>{p.name}</h2>
          <p class="pr-sum">{p.summary}</p>
        </div>
        <ul class="board">
          {p.tiers.map((c) => (
            <li class="item">
              <div class="item-head">
                <h3>{c.name}</h3>
                <span class="dots" aria-hidden="true"></span>
                <span class="price">{c.price}</span>
              </div>
              <p class="sum">{c.summary}</p>
              <ul class="incl">{c.includes.map((i) => <li>{i}</li>)}</ul>
              {c.time && <p class="time">{c.time}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section practice" id="ordering">
    <div class="wrap pr-grid">
      <div class="pr-head">
        <h2>Restaurant ordering</h2>
        <p class="pr-sum">{ordering.summary}</p>
      </div>
      <div>
        <ul class="board">
          {ordering.packages.map((k) => (
            <li class="item">
              <div class="item-head">
                <h3>{k.name}</h3>
                <span class="dots" aria-hidden="true"></span>
                <span class="price">{k.setup} + {k.monthly.replace(' per outlet', '')}</span>
              </div>
              <p class="sum">{k.summary}</p>
            </li>
          ))}
        </ul>
        <a class="btn" href={`${base}/ordering/`}>See what each package includes</a>
      </div>
    </div>
  </section>

  <section class="section ways">
    <div class="wrap">
      <h2>Ways to work</h2>
      <ul class="ways-grid">
        {waysToWork.map((w) => (
          <li><h3>{w.name}</h3><p class="w-price">{w.price}</p><p>{w.summary}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap pr-grid">
      <div class="pr-head">
        <h2>Who does the work</h2>
        <p class="pr-sum">{collective.lede}</p>
      </div>
      <dl class="roles">
        {collective.roles.map((r) => (<div><dt>{r.name}</dt><dd>{r.text}</dd></div>))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Every project includes</h2>
      <dl class="included">
        {included.map((i) => (<div><dt>{i.name}</dt><dd>{i.text}</dd></div>))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How a project works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li><h3>{s.name}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-wrap">
      <h2>Questions</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="wrap">
      <h2>Have something in mind?</h2>
      <p class="lede-ink">Describe it in a sentence. That is enough to start.</p>
      <div class="btns"><a class="btn solid" href={`${base}/contact/`}>Start a project</a></div>
    </div>
  </section>
</Base>
<style>
  .founding{background:var(--paper);border-block:1px solid var(--line)}
  .founding-inner{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:1rem 2.5rem;align-items:center;padding-top:2.2rem;padding-bottom:2.2rem}
  .f-tag{margin:0;font-weight:600;color:var(--cobalt);white-space:nowrap}
  .founding h2{font-size:clamp(1.5rem,2.8vw,2rem);margin-bottom:.4rem}
  .founding p{margin:0;max-width:60ch;color:var(--ink-soft)}
  .founding .btn{white-space:nowrap}
  .included{display:grid;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr));gap:1.5rem 2.5rem;margin:2rem 0 0}
  .included div{border-top:1px solid var(--ink);padding-top:.9rem}
  .included dt{font-family:var(--serif);font-size:1.3rem;margin-bottom:.35rem}
  .included dd{margin:0;color:var(--ink-soft)}
  .faq-wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:2rem 4rem}
  .faq details{border-top:1px solid var(--line)}
  .faq details:last-child{border-bottom:1px solid var(--line)}
  .faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1rem;padding:1.1rem 0;font-family:var(--serif);font-size:1.55rem}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:'+';font-family:var(--sans);color:var(--ink-soft);transition:transform .2s}
  .faq details[open] summary::after{transform:rotate(45deg)}
  .faq details p{margin:0 0 1.2rem;max-width:62ch;color:var(--ink-soft)}
  .closing{text-align:left}
  .lede-ink{font-size:1.2rem;color:var(--ink-soft);margin:1rem 0 0}
  .board{list-style:none;margin:0;padding:0;max-width:56rem}
  .item{padding:2rem 0;border-bottom:1px solid var(--line)}
  .item:first-child{border-top:1px solid var(--ink)}
  .item-head{display:grid;grid-template-columns:auto 1fr auto;gap:.9rem;align-items:baseline}
  .item-head h2{font-size:clamp(1.9rem,3.6vw,2.6rem)}
  .dots{border-bottom:1px dotted var(--ink-soft);transform:translateY(-.35em)}
  .price{font-weight:600;font-size:1.1rem;white-space:nowrap}
  .sum{margin:.6rem 0 0;font-size:1.1rem;max-width:52ch}
  .incl{margin:.9rem 0 0;padding-left:1.1rem;color:var(--ink-soft);columns:2;column-gap:2.5rem}
  .incl li{break-inside:avoid;margin-bottom:.3rem}
  .time{margin:.9rem 0 0;font-size:.95rem;color:var(--ink-soft)}
  .index{list-style:none;margin:clamp(1.8rem,4vw,2.6rem) 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .index a{display:flex;flex-direction:column;gap:.3rem;padding:1.1rem 1.25rem;background:var(--wall);text-decoration:none;height:100%}
  .index a:hover{background:var(--paper)}
  .ix-n{font-family:var(--serif);font-size:1.6rem;line-height:1.1}
  .ix-p{color:var(--ink-soft);font-size:.95rem}
  .practice{scroll-margin-top:4.5rem;border-top:1px solid var(--line)}
  .pr-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:2rem clamp(2.5rem,5vw,5rem)}
  .pr-head h2{font-size:clamp(2.4rem,4.5vw,3.6rem)}
  .pr-sum{margin:1rem 0 0;color:var(--ink-soft);max-width:34ch}
  .item-head h3{font-size:clamp(1.7rem,3vw,2.2rem)}
  .practice .btn{margin-top:1.6rem}
  .ways{background:var(--paper);border-block:1px solid var(--line)}
  .ways-grid{list-style:none;margin:2rem 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem clamp(2rem,4vw,3rem)}
  .ways-grid li{border-top:1px solid var(--ink);padding-top:1rem}
  .ways-grid h3{font-size:1.6rem}
  .w-price{margin:.3rem 0 .6rem;font-weight:600}
  .ways-grid p:last-child{margin:0;color:var(--ink-soft)}
  .roles{margin:0;display:grid;gap:0}
  .roles div{border-top:1px solid var(--line);padding:1rem 0}
  .roles div:first-child{border-top-color:var(--ink)}
  .roles dt{font-family:var(--serif);font-size:1.6rem;margin-bottom:.25rem}
  .roles dd{margin:0;color:var(--ink-soft)}
  .steps{list-style:none;counter-reset:s;margin:2.2rem 0 0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2rem}
  .steps li{counter-increment:s;border-top:1px solid var(--ink);padding-top:1rem}
  .steps li::before{content:counter(s);font-family:var(--serif);font-size:2.6rem;line-height:1;display:block;margin-bottom:.6rem;color:var(--cobalt)}
  .steps h3{font-size:1.3rem;margin-bottom:.4rem}
  .steps p{margin:0;color:var(--ink-soft)}
  @media (max-width:860px){.founding-inner,.faq-wrap,.pr-grid,.index,.ways-grid{grid-template-columns:minmax(0,1fr)}.price{white-space:normal}}
  @media (max-width:860px){.steps{grid-template-columns:1fr 1fr}.incl{columns:1}}
  @media (max-width:520px){.steps{grid-template-columns:1fr}.item-head{grid-template-columns:1fr}.dots{display:none}}
</style>
