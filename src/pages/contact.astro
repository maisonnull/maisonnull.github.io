---
import Base from '../layouts/Base.astro';
import { studio } from '../config';
const { tallyFormId, callLink } = studio;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tallySrc = `https://tally.so/embed/${tallyFormId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---
<Base title="Contact" current="contact" description="Start a project with Maison Null.">
  <section class="banner">
    <div class="wrap">
      <h1>Start a project</h1>
      <p class="lede">Tell me what you want to make, roughly when you need it, and what budget you have in mind. I reply within two working days.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact">
      <div class="main">
        <div class="carried" hidden>
          <p class="c-label">Your brief, carried over from the frame</p>
          <p class="c-text"></p>
        </div>

        {tallyFormId ? (
          <iframe class="tally" data-tally-src={tallySrc} title="Commission enquiry form" loading="lazy"></iframe>
        ) : (
          <div class="soon">
            <p class="big">Enquiries open soon.</p>
            <p class="hint">The enquiry form is being set up. Check back shortly.</p>
          </div>
        )}
      </div>

      <aside class="next">
        <h2>What happens next</h2>
        <ol>
          <li><b>I reply within two working days</b> with a few questions, if any.</li>
          <li><b>We agree the scope</b>, price and dates in writing.</li>
          <li><b>You get a preview link</b> as soon as there&rsquo;s something to see.</li>
        </ol>
        <p><a href={`${base}/commissions/`}>See prices and the FAQ</a></p>
        {callLink && (
          <div class="call">
            <p class="call-h">Rather talk it through?</p>
            <p>Book a free 15-minute call and describe the project out loud.</p>
            <a class="btn" href={callLink} target="_blank" rel="noopener" data-call>Book a 15-minute call</a>
          </div>
        )}
      </aside>
    </div>
  </section>
</Base>

<script>
  const brief = (new URLSearchParams(location.search).get('brief') || '').slice(0, 280).trim();
  if (brief) {
    const carried = document.querySelector<HTMLElement>('.carried');
    if (carried) {
      carried.hidden = false;
      carried.querySelector('.c-text')!.textContent = `“${brief}”`;
    }
  }
  const track = (path: string, title: string) => (window as any).mnTrack?.(path, title);
  document.querySelectorAll('[data-call]').forEach((a) => a.addEventListener('click', () => track('call-booking-opened', 'Opened the call booking page')));

  // When the form is sent: count it, and forget the sentence saved by the home page frame.
  addEventListener('message', (e) => {
    if (e.origin !== 'https://tally.so') return;
    const data = typeof e.data === 'string' ? e.data : JSON.stringify(e.data ?? '');
    if (data.includes('Tally.FormSubmitted')) {
      track('brief-submitted', 'Submitted the enquiry form');
      try { localStorage.removeItem('mn-brief'); } catch {}
    }
  });

  // Load the Tally form. Its embed script resizes the iframe to fit the form.
  const tally = document.querySelector<HTMLIFrameElement>('.tally');
  if (tally) {
    // Pass the brief into the form's hidden field named "brief".
    if (brief) tally.dataset.tallySrc += `&brief=${encodeURIComponent(brief)}`;
    const direct = () => { if (!tally.src) tally.src = tally.dataset.tallySrc!; };
    const s = document.createElement('script');
    s.src = 'https://tally.so/widgets/embed.js';
    s.onload = () => { const T = (window as any).Tally; T ? T.loadEmbeds() : direct(); };
    s.onerror = direct;
    document.body.appendChild(s);
    setTimeout(direct, 4000);
  }
</script>

<style>
  .contact{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:2.5rem clamp(2.5rem,6vw,5rem);align-items:start}
  .carried{background:var(--white);border-left:3px solid var(--cobalt);padding:1rem 1.2rem;margin-bottom:2rem}
  .c-label{margin:0 0 .3rem;font-size:.85rem;color:var(--ink-soft)}
  .c-text{margin:0;font-family:var(--serif);font-size:1.4rem;line-height:1.3}
  .tally{width:100%;min-height:640px;border:0;display:block}
  .big{font-family:var(--serif);font-size:clamp(1.6rem,3.2vw,2.4rem);margin:0 0 .6rem}
  .hint{margin:0;color:var(--ink-soft);font-size:.95rem;max-width:52ch}
  .next{border-top:1px solid var(--ink);padding-top:1rem}
  .next h2{font-size:1.6rem;margin-bottom:1rem}
  .next ol{margin:0 0 1.2rem;padding-left:1.2rem;color:var(--ink-soft)}
  .next li{margin-bottom:.7rem}
  .next b{color:var(--ink);font-weight:600}
  .next a{color:var(--ink-soft)}
  .call{margin-top:2rem;padding:1.3rem;background:var(--white);border:1px solid var(--line);border-radius:14px}
  .call p{margin:0 0 .9rem;color:var(--ink-soft)}
  .call .call-h{margin:0 0 .3rem;color:var(--ink);font-family:var(--serif);font-size:1.5rem;line-height:1.1}
  .call .btn{color:var(--ink)}
  .call .btn:hover{color:var(--wall)}
  @media (max-width:860px){.contact{grid-template-columns:1fr}}
</style>
