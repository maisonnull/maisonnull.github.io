---
// A project's phone mockup, shared with the drunkwiz.github.io portfolio.
import '../styles/screens.css';
import screens from '../data/screens.json';
interface Props { id: string; scale?: number }
const { id, scale = 1 } = Astro.props;
const html = (screens as Record<string, string>)[id];
---
{html && (
  <div class="phone-holder" style={`--s:${scale}`} aria-hidden="true">
    <div class="phone" set:html={html} />
  </div>
)}
<style>
  .phone-holder{zoom:var(--s)}
  .phone-holder .phone{margin:0}
</style>
