---
// The home page's signature piece: an empty frame you can write a brief into.
// Idle, it ghost-types example briefs. Typing sets your words into the frame,
// retitles the placard, and offers to carry the brief to the contact page.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const examples = [
  'A booking page for a hair salon',
  'A menu site the café can update itself',
  'A launch page for an app, by Friday',
  'A dashboard my team will actually open',
  'A portfolio that feels like a gallery',
];
---
<figure class="brief" data-examples={JSON.stringify(examples)}>
  <div class="light" aria-hidden="true"></div>
  <div class="frame">
    <div class="mat">
      <label class="canvas" for="brief-input">
        <span class="sr-only">Describe what you would like made</span>
        <span class="idle" aria-hidden="true"><span class="idle-line"><span class="ghost"></span><span class="caret"></span></span></span>
        <textarea id="brief-input" class="ink" maxlength="140" rows="1" spellcheck="true" autocomplete="off"></textarea>
      </label>
    </div>
  </div>
  <figcaption class="placard">
    <p class="p-title"><em class="p-name">Untitled (null)</em>, 2026</p>
    <p class="p-medium">An empty screen, waiting</p>
    <p class="p-note">Click the canvas and write what you&rsquo;d like made.</p>
    <a class="p-cta" href={`${base}/contact/`} hidden>Send this brief</a>
  </figcaption>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('.brief');
  if (fig) {
    const input = fig.querySelector<HTMLTextAreaElement>('textarea')!;
    const ghost = fig.querySelector<HTMLElement>('.ghost')!;
    const name = fig.querySelector<HTMLElement>('.p-name')!;
    const medium = fig.querySelector<HTMLElement>('.p-medium')!;
    const note = fig.querySelector<HTMLElement>('.p-note')!;
    const cta = fig.querySelector<HTMLAnchorElement>('.p-cta')!;
    const examples: string[] = JSON.parse(fig.dataset.examples || '[]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const contact = cta.getAttribute('href') || '/contact/';
    const track = (path: string, title: string) => (window as any).mnTrack?.(path, title);

    // Remember the sentence in this browser only, so a visitor who leaves finds it waiting.
    const KEY = 'mn-brief';
    const store = {
      get: () => { try { return localStorage.getItem(KEY) || ''; } catch { return ''; } },
      set: (v: string) => { try { v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY); } catch {} },
    };
    const saved = store.get();
    if (saved) input.value = saved;
    let restored = !!saved, counted = false;

    // Ghost typing: type an example, pause, erase, next. Stops while the visitor writes.
    let ex = 0, pos = 0, dir = 1, timer = 0;
    function tick() {
      if (input.value || document.activeElement === input) { ghost.textContent = ''; return; }
      const text = examples[ex];
      pos += dir;
      ghost.textContent = text.slice(0, pos);
      let wait = dir > 0 ? 55 + Math.random() * 70 : 22;
      if (dir > 0 && pos >= text.length) { dir = -1; wait = 1900; }
      else if (dir < 0 && pos <= 0) { dir = 1; ex = (ex + 1) % examples.length; wait = 500; }
      timer = window.setTimeout(tick, wait);
    }
    function startGhost() {
      clearTimeout(timer);
      if (reduce) { ghost.textContent = ''; return; }
      pos = 0; dir = 1; timer = window.setTimeout(tick, 900);
    }

    function fit() {
      input.style.height = 'auto';
      input.style.height = input.scrollHeight + 'px';
    }

    function render() {
      fit();
      const v = input.value.trim().replace(/\s+/g, ' ');
      fig.classList.toggle('has-text', !!v);
      if (v) {
        const short = v.length > 46 ? v.slice(0, 44).trimEnd() + '…' : v;
        name.textContent = `Untitled (${short})`;
        medium.textContent = 'A brief, written by you';
        note.textContent = restored
          ? 'Your sentence is still here from last time. Send it when you’re ready.'
          : 'Every project here starts with a sentence like this.';
        cta.hidden = false;
        cta.href = `${contact}?brief=${encodeURIComponent(v)}`;
      } else {
        name.textContent = 'Untitled (null)';
        medium.textContent = 'An empty screen, waiting';
        note.textContent = 'Click the canvas and write what you’d like made.';
        cta.hidden = true;
        cta.href = contact;
      }
    }

    input.addEventListener('input', () => {
      restored = false;
      render();
      store.set(input.value.trim());
      if (!counted && input.value.trim()) { counted = true; track('brief-written', 'Wrote in the frame'); }
    });
    const send = () => track('brief-sent', 'Sent the brief from the frame');
    cta.addEventListener('click', send);
    input.addEventListener('focus', () => { clearTimeout(timer); ghost.textContent = ''; fig.classList.add('writing'); });
    input.addEventListener('blur', () => { fig.classList.remove('writing'); if (!input.value) startGhost(); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && input.value.trim()) { e.preventDefault(); send(); window.location.href = cta.href; }
    });
    render();
    if (!saved) startGhost();
  }
</script>

<style>
  .brief{position:relative;margin:0;display:grid;grid-template-columns:auto 15rem;gap:1.6rem;align-items:end;justify-content:start}
  .light{display:none}
  .frame{
    position:relative;width:clamp(15rem,24vw,19rem);aspect-ratio:4/5;
    padding:9px;background:var(--ink);
    box-shadow:0 30px 50px -24px rgba(23,24,27,.45);
    transition:box-shadow .3s;
  }
  .brief.writing .frame{box-shadow:0 0 0 3px var(--cobalt), 0 30px 50px -24px rgba(23,24,27,.45)}
  .mat{height:100%;padding:12%;background:#FAFAF8}
  .canvas{
    position:relative;height:100%;display:flex;align-items:center;justify-content:center;
    background:#FFFFFF;box-shadow:inset 0 1px 4px rgba(0,0,0,.12);cursor:text;
    padding:12% 10%;text-align:center;overflow:hidden;
  }
  .idle{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:0 10%;pointer-events:none}
  .idle-line{display:block;text-align:center;line-height:1.25}
  .ghost{font-family:var(--serif);font-size:clamp(1.15rem,1.6vw,1.4rem);line-height:1.25;color:#9C9EA3}
  .caret{display:inline-block;width:2px;height:1.15em;background:var(--cobalt);margin-left:2px;vertical-align:-.2em;animation:blink 1.1s steps(1,end) infinite}
  .brief.writing .idle,.brief.has-text .idle{display:none}
  .ink{
    position:relative;width:100%;max-height:100%;border:0;resize:none;background:transparent;outline:none;
    padding:0;display:block;overflow:hidden;
    font-family:var(--serif);font-size:clamp(1.2rem,1.8vw,1.5rem);line-height:1.25;color:var(--ink);text-align:center;
    caret-color:var(--cobalt);
  }
  .placard{
    position:relative;background:#FFFFFF;color:var(--ink);padding:1rem 1.1rem;font-size:.85rem;line-height:1.45;
    border:1px solid var(--line);margin-bottom:.4rem;
  }
  .placard p{margin:0}
  .p-title{font-family:var(--serif);font-size:1.15rem;margin-bottom:.15rem !important;overflow-wrap:anywhere}
  .p-name{font-style:normal}
  .p-medium{color:var(--ink-soft);margin-bottom:.6rem !important}
  .p-cta{
    display:inline-block;margin-top:.8rem;padding:.55rem .95rem;background:var(--ink);color:var(--wall);
    font-weight:500;font-size:.88rem;text-decoration:none;border-radius:999px;
  }
  .p-cta:hover{background:#000;color:#fff}
  .p-cta[hidden]{display:none}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .canvas:focus-within{box-shadow:inset 0 1px 4px rgba(0,0,0,.12)}
  @keyframes blink{50%{opacity:0}}
  @media (max-width:900px){
    .brief{grid-template-columns:1fr;justify-items:start}
    .frame{width:min(17rem,80vw)}
    .placard{max-width:17rem}
  }
  @media (prefers-reduced-motion:reduce){
    .caret{animation:none}
  }
</style>
