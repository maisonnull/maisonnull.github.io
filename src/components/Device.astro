---
// A real screen in a browser or phone frame.
// mode "hover": the page scrolls through on hover or keyboard focus.
// mode "scroll": the page scrolls as the visitor scrolls the window (used once, in the hero).
// mode "still": just the screen.
interface Props {
  kind?: 'browser' | 'phone';
  src: string;        // file in /public/samples, without extension
  w: number;          // natural image size, for layout and scroll speed
  h: number;
  alt: string;
  mode?: 'hover' | 'scroll' | 'still';
  eager?: boolean;
  caption?: string;
  class?: string;
  top?: string;       // colour behind the phone's status bar
}
const { kind = 'browser', src, w, h, alt, mode = 'still', eager = false, caption, class: cls, top = '#fff' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const frameRatio = kind === 'browser' ? 10 / 16 : 844 / 390;
const extra = Math.max(0, h / w / frameRatio - 1);           // how many screens of page sit below the fold
const dur = Math.min(14, Math.max(2.5, extra * 2.4)).toFixed(1);
const scrolls = mode !== 'still' && extra > 0.05;
---
<figure class:list={['device', kind, cls]} data-mode={scrolls ? mode : 'still'} style={`--dur:${dur}s;--top:${top}`}>
  <div class="body">
    {kind === 'browser' && <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>}
    {kind === 'phone' && <div class="island" aria-hidden="true"></div>}
    <div class="screen" tabindex={scrolls && mode === 'hover' ? 0 : undefined}>
      <img src={`${base}/samples/${src}.webp`} width={w} height={h} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .device{margin:0;min-width:0}
  .body{position:relative;background:#fff;overflow:hidden;
    box-shadow:0 1px 0 rgba(0,0,0,.04), 0 30px 60px -28px rgba(23,24,27,.35), 0 12px 24px -16px rgba(23,24,27,.18)}
  .browser .body{border-radius:12px;border:1px solid #D3D3CE}
  .bar{display:flex;gap:6px;align-items:center;height:30px;padding:0 12px;background:#F3F3F0;border-bottom:1px solid #DEDED9}
  .bar i{width:9px;height:9px;border-radius:50%;background:#D3D3CE}
  .phone .body{border-radius:46px;padding:9px;background:#1B1C1F}
  .island{position:absolute;z-index:2;top:17px;left:50%;width:28%;height:22px;margin-left:-14%;border-radius:20px;background:#1B1C1F}
  .screen{position:relative;overflow:hidden;container-type:size;outline-offset:-2px}
  .browser .screen{aspect-ratio:16/10}
  .phone .screen{aspect-ratio:390/844;border-radius:37px;background:var(--top);padding-top:34px}
  .screen img{width:100%;height:auto;max-width:none;will-change:transform}
  [data-mode="hover"] .screen img{transition:transform 1.4s cubic-bezier(.3,.7,.2,1)}
  [data-mode="hover"] .screen:hover img,
  [data-mode="hover"] .screen:focus-visible img{transform:translateY(calc(-100% + 100cqh));transition:transform var(--dur) cubic-bezier(.45,.05,.4,1)}
  [data-mode="scroll"] .screen img{transform:translateY(calc((-100% + 100cqh) * var(--t, 0)))}
  figcaption{margin-top:1rem;font-size:.9rem;color:var(--ink-soft);max-width:40ch}
  @media (prefers-reduced-motion:reduce){
    [data-mode] .screen img{transition:none !important;transform:none !important}
  }
</style>
